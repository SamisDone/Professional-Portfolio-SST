{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/coming-soon",
      "destination": "https://samonwitasarker.pages.dev/",
      "statusCode": 301
    },
    {
      "source": "/og.png",
      "destination": "https://samonwitasarker.pages.dev/og/home.png",
      "statusCode": 301
    },
    {
      "source": "/:path(.+)/",
      "destination": "https://samonwitasarker.pages.dev/:path",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://samonwitasarker.pages.dev/:path*",
      "statusCode": 301
    }
  ]
}
