# The site's public origin, with no trailing slash.
# Used for the canonical link, Open Graph tags, and sitemap.xml.
#
# Not needed on Vercel or Netlify — both expose the deployed host at build
# time and vite.config.ts picks it up. Set this only for a custom domain, or
# to produce correct meta tags from a local `npm run build`.
VITE_SITE_URL=https://your-domain.com
